# DataCleanse configuration. Copy to .env.local and set what you need.
# Read on the server only. Restart the server after changing a value.
#
# Every line below is commented out, so the defaults apply. Note that with no
# AI_PROVIDER and no ANTHROPIC_API_KEY, the AI provider defaults to "local"
# (a model at http://localhost:11434/v1). To run rules only, set AI_PROVIDER=off.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Folder for app.db (SQLite) and files/ (uploads and cleaned copies).
# Relative paths resolve from the folder the server starts in. Default: ./.data
# DATA_DIR=./.data

# Public URL of the app. Used in sign-in and password-reset links. Default: http://localhost:3000
# APP_URL=https://datacleanse.example.com

# Secret for signing download links and encrypting saved API keys and 2FA secrets.
# Required in production, at least 32 characters. Generate one with: openssl rand -hex 32
# Changing it later makes saved keys and 2FA secrets unreadable. Development uses a built-in value if unset.
# APP_SECRET=

# Largest accepted upload, in megabytes. Default: 200
# MAX_UPLOAD_MB=200

# Cleaning jobs that run at the same time in this process. Minimum 1. Default: 2
# JOB_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Email (sign-in links and password resets)
# ---------------------------------------------------------------------------

# SMTP server as a nodemailer URL. Required in production.
# In development, unset means emails are printed to the server log instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Production without SMTP: emails (sign-in and reset links) are refused unless you opt in to
# printing them to the server log. Anyone who can read the log can then sign in as your users.
# MAIL_LOG=1
# Sender address. Default: DataCleanse <no-reply@localhost>
# MAIL_FROM=DataCleanse <no-reply@example.com>

# ---------------------------------------------------------------------------
# Malware scanning
# ---------------------------------------------------------------------------

# Address of a clamd (ClamAV) daemon. If set and unreachable, uploads are rejected.
# If unset, built-in checks reject files that carry executable or archive signatures.
# CLAMD_ADDRESS=127.0.0.1:3310

# ---------------------------------------------------------------------------
# AI (optional). Admin > Configuration can override these at runtime.
# Each user can also choose their own key in Settings > AI provider.
# ---------------------------------------------------------------------------

# Provider for the whole instance: anthropic | openai | local | off
#   anthropic  Anthropic API
#   openai     any hosted OpenAI-compatible API (OpenAI, OpenRouter, Groq, Together...)
#   local      any OpenAI-compatible server on your machine (Ollama, LM Studio, llama.cpp, vLLM)
#   off        rules only; nothing is sent to a model
# Default: anthropic if ANTHROPIC_API_KEY is set, otherwise local.
# AI_PROVIDER=off

# Model id sent with each request.
# Defaults: anthropic claude-opus-5-5, openai gpt-4o-mini, local llama3.1
# AI_MODEL=

# OpenAI-compatible base URL ending in /v1. Used by openai and local only; ignored for anthropic.
# Defaults: openai https://api.openai.com/v1, local http://localhost:11434/v1
# AI_BASE_URL=

# Key for the OpenAI-compatible endpoint. Required for openai. Optional for local.
# AI_API_KEY=

# Key for Anthropic. Needed for anthropic unless the SDK finds another credential,
# such as ANTHROPIC_AUTH_TOKEN.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Examples (uncomment one block; leave the others commented)
# ---------------------------------------------------------------------------

# --- Anthropic (cloud). Data is sent to Anthropic. ---
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5

# --- Ollama (your own install; DataCleanse doesn't ship a model). Pull the model in Ollama first. ---
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# --- LM Studio (local). Start its local server (port 1234) and use the model id it shows. ---
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=your-loaded-model-id

# --- Hosted OpenAI-compatible API. Data is sent to that provider. ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# --- Rules only. Nothing is sent to a model. ---
# AI_PROVIDER=off
