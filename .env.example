# DataCleanse AI settings. Copy to .env.local and uncomment one block.
# All variables are read on the server only. Leave everything commented to run
# rules-only (no AI). With no ANTHROPIC_API_KEY set, the default provider is "local".

# AI_PROVIDER: anthropic | openai | local | off
#   Defaults to "anthropic" when ANTHROPIC_API_KEY is set, otherwise "local".
# AI_MODEL: model id. Defaults per provider (anthropic: claude-opus-5-5, openai: gpt-4o-mini, local: llama3.1).
# AI_BASE_URL: OpenAI-compatible base URL ending in /v1. Used by "openai" and "local".
# AI_API_KEY: key for the OpenAI-compatible endpoint. Optional for "local".
# ANTHROPIC_API_KEY: key for "anthropic".

# --- Anthropic (cloud) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5

# --- Ollama (local) ---
# Run `ollama pull llama3.1` first.
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# --- LM Studio (local) ---
# Start the local server in LM Studio (default port 1234) and use the model id it shows.
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=your-loaded-model-id

# --- Hosted OpenAI-compatible (OpenAI, OpenRouter, Groq, Together...) ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# --- Off (rules only, no data sent to any model) ---
# AI_PROVIDER=off
